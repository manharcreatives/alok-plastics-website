# ─────────────────────────────────────────────────────────────────────────────
# Alok Plastics — Hostinger (Apache / LiteSpeed) rules for the static export.
# Upload next to index.html in public_html/. Every block is wrapped in <IfModule>
# so a module that is missing on the plan degrades gracefully instead of 500-ing.
# Canonical host: https://alokplastics.com  (non-www, HTTPS, trailing slash)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ServerSignature Off
AddDefaultCharset UTF-8

# ── 1. HTTPS + non-www (single 301 hop) ─────────────────────────────────────
<IfModule mod_rewrite.c>
RewriteEngine On

# Behind Hostinger's proxy %{HTTPS} can read "off" even on TLS requests, so also honour X-Forwarded-Proto.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://alokplastics.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.alokplastics\.com$ [NC]
RewriteRule ^ https://alokplastics.com%{REQUEST_URI} [L,R=301]

# ── 2. Trailing-slash normalisation ───────────────────────────────────────
# Static export (trailingSlash: true) writes /about/index.html. A request for /about
# (no slash, not a real file) is redirected to /about/. Real files (.txt, .xml, .png …) are untouched.
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ https://alokplastics.com/$1/ [L,R=301]

# ── 3. Legacy WordPress URLs ──────────────────────────────────────────────
# TODO(client): once the old alokplastics.com URL list is exported, add one
# "RewriteRule ^old-path/?$ /new-path/ [R=301,L]" per line here (see docs/seo-geo.md).
</IfModule>

# ── 4. Custom 404 (Next writes out/404.html) ────────────────────────────────
ErrorDocument 404 /404.html

# ── 5. Types ─────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/plain .txt
</IfModule>

# ── 6. Compression ──────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ── 7. Caching ──────────────────────────────────────────────────────────────
# /_next/static/* is content-hashed → immutable for a year.
# Images / fonts are 1 year: when a file changes, give it a NEW filename.
# HTML and the RSC .txt payloads stay short so a redeploy shows up within minutes.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 5 minutes"
ExpiresByType text/html "access plus 5 minutes"
ExpiresByType text/plain "access plus 5 minutes"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
ExpiresByType application/manifest+json "access plus 1 day"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
# (SetEnvIf + env= instead of <If>: works on both Apache and LiteSpeed, which Hostinger runs.)
SetEnvIf Request_URI "^/_next/static/" HASHED_ASSET
Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
<FilesMatch "\.(html|txt)$">
Header set Cache-Control "public, max-age=300, must-revalidate"
</FilesMatch>
<FilesMatch "^(robots\.txt|llms\.txt|llms-full\.txt|sitemap\.xml)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# ── 8. Security headers ───────────────────────────────────────────────────
# No Content-Security-Policy on purpose: Next.js injects inline scripts (and GA4 will be added later);
# a CSP that does not break them needs per-build nonces/hashes, which a static host cannot provide.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Strict-Transport-Security "max-age=31536000"
# Keep the design lab and the form endpoint out of search results even if reached directly.
SetEnvIf Request_URI "^/(lab|api)/" NOINDEX_AREA
Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_AREA
</IfModule>

# ── 9. Never serve config / source / dump files ─────────────────────────────
<FilesMatch "(^\.|\.(example|env|ini|log|sql|bak|sh|md|lock|map|yml|yaml)$|^config\.php$|^composer\.(json|lock)$)">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
