/**
 * Alok Plastics — PHP endpoint configuration
 * IMPORTANT: Copy this file to config.php and fill in real values.
 *            config.php is in .gitignore and must NEVER be committed.
 *
 * See docs/deploy-hostinger.md for full setup instructions.
 */

// Recipient email — all enquiry emails go here
$ALOK_TO_EMAIL = 'enquiry@alokplastics.com';   // TODO(client): confirm enquiry email address

// Sender email — must match a mailbox on your Hostinger account
$ALOK_FROM_EMAIL = 'noreply@alokplastics.com';  // TODO(client): create this mailbox on Hostinger

// Production site URL — used for CORS origin check
$ALOK_SITE_URL = 'https://alokplastics.com';

// SMTP credentials (for PHPMailer — optional; php mail() works without this)
$ALOK_SMTP_HOST = 'smtp.hostinger.com';
$ALOK_SMTP_PORT = 465;                          // 465 for SSL, 587 for TLS
$ALOK_SMTP_USER = 'noreply@alokplastics.com';   // TODO(client)
$ALOK_SMTP_PASS = 'YOUR_EMAIL_PASSWORD_HERE';   // TODO(client): never commit this

// Writable directory for rate-limit files
// Hostinger: /tmp or sys_get_temp_dir() usually works
$ALOK_RATE_DIR = sys_get_temp_dir();

// WhatsApp number that receives order messages, with country code (digits only is fine). TODO(client)
$ALOK_WHATSAPP = '91XXXXXXXXXX';

// Google Apps Script web app (see docs/google-apps-script/README.md). Leave empty to skip the Sheet/Drive step.
$ALOK_GAS_URL = '';
$ALOK_GAS_SECRET = '';

// WasenderAPI — inbound-message webhook + outbound auto-reply (proforma PDF).
// key    = session Bearer key (Wasender dashboard). secret = Webhook Secret you set in the dashboard.
// Leave empty to disable the auto-reply webhook.
$ALOK_WHATSAPP_API = [
    'key' => '',
    'secret' => '',
    'base' => 'https://wasenderapi.com',
    'autosend' => false, // true = message the customer automatically whenever an order's status changes (manual mode: false)
    'webhook' => false, // true = accept inbound WhatsApp webhook (wa-webhook.php); false = ignore it
];

// Business identity printed on the GST invoice / proforma PDFs, the WhatsApp captions and the admin "send new proforma" form.
// 'upiqr' = path to the payment QR image (relative to the site root, or absolute). Missing file = the PDF simply has no QR.
// NOTE (public repo): GSTIN / bank account / IFSC below are PLACEHOLDERS. Real values live in the ignored config.php only.
$ALOK_BUSINESS = [
    'name' => 'ALOK PLASTICS',
    'gstin' => 'XXXXXXXXXXXXXXXX',
    'tagline' => ['Specialist in :', 'All Type of Plastic, L.D.P, H.H.P.S., A.B.S., Nilon, Rubber, Plastic Molding etc.'],
    'address' => ['Plot No. 6, Industrial Area, Phase-II, Chandigarh-160002'],
    'phones' => ['9000000000', '9000000001'],
    'state' => 'Chandigarh',
    'bank' => ['BANK DETAIL', 'PUNJAB NATIONAL BANK, Industrial Area, Ph-2, CHD.', 'Account No. : 0000000000000000', 'IFSC Code : PUNBXXXXXXX'],
    'terms' => [
        '1. All disputes subject to Chandigarh Jurisdiction only.',
        '2. Interest @ 18% p.a. will be charged if the bill is not paid within 30 days.',
        '3. Goods once sold will not be taken back.',
    ],
    'copies' => 'White : Original | Pink : Duplicate | Yellow : Triplicate',
    'proforma_note' => 'This is a proforma invoice, not a tax invoice. Final price, stock and delivery are confirmed by Alok Plastics.',
    'upiqr' => 'brand/upiqr.png',
];

// Customer sign-in code (OTP). provider: 'wasender' | 'msg91' | 'fast2sms' | 'webhook'. Leave provider empty until an account exists.
// wasender: sends the code over WhatsApp using $ALOK_WHATSAPP_API above (no DLT/SMS needed).
// msg91: key = authkey, template = DLT-approved OTP template id. fast2sms: key = API key.
// webhook: your own endpoint (n8n, Make, WhatsApp provider) that receives {phone, otp, name, message}.
// dev_mode true returns the code in the API response for testing ONLY. Never enable it on the live site.
$ALOK_OTP = [
    'provider' => '',
    'key' => '',
    'template' => '',
    'webhook' => '',
    'dev_mode' => false,
    'skip' => true, // true = no OTP at all: name + mobile signs in directly (orders are flagged "not verified" in the admin)
];
