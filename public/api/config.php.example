<?php
/**
 * Alok Plastics — PHP endpoint configuration
 * IMPORTANT: Copy this file to config.php and fill in real values.
 *            config.php is in .gitignore and must NEVER be committed.
 *
 * See docs/deploy-hostinger.md for full setup instructions.
 */

// Recipient email — all enquiry emails go here
$ALOK_TO_EMAIL = 'enquiry@alokplastics.com';   // TODO(client): confirm enquiry email address

// Sender email — must match a mailbox on your Hostinger account
$ALOK_FROM_EMAIL = 'noreply@alokplastics.com';  // TODO(client): create this mailbox on Hostinger

// Production site URL — used for CORS origin check
$ALOK_SITE_URL = 'https://alokplastics.com';

// SMTP credentials (for PHPMailer — optional; php mail() works without this)
$ALOK_SMTP_HOST = 'smtp.hostinger.com';
$ALOK_SMTP_PORT = 465;                          // 465 for SSL, 587 for TLS
$ALOK_SMTP_USER = 'noreply@alokplastics.com';   // TODO(client)
$ALOK_SMTP_PASS = 'YOUR_EMAIL_PASSWORD_HERE';   // TODO(client): never commit this

// Writable directory for rate-limit files
// Hostinger: /tmp or sys_get_temp_dir() usually works
$ALOK_RATE_DIR = sys_get_temp_dir();

// WhatsApp number that receives order messages, with country code (digits only is fine). TODO(client)
$ALOK_WHATSAPP = '91XXXXXXXXXX';

// Google Apps Script web app (see docs/google-apps-script/README.md). Leave empty to skip the Sheet/Drive step.
$ALOK_GAS_URL = '';
$ALOK_GAS_SECRET = '';

// Customer sign-in code (OTP). provider: 'msg91' | 'fast2sms' | 'webhook'. Leave provider empty until an SMS account exists.
// msg91: key = authkey, template = DLT-approved OTP template id. fast2sms: key = API key.
// webhook: your own endpoint (n8n, Make, WhatsApp provider) that receives {phone, otp, name, message}.
// dev_mode true returns the code in the API response for testing ONLY. Never enable it on the live site.
$ALOK_OTP = [
    'provider' => '',
    'key' => '',
    'template' => '',
    'webhook' => '',
    'dev_mode' => false,
];
