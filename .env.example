# Neon Postgres (added automatically by the Vercel Neon integration; copy with `vercel env pull .env.local`)
DATABASE_URL=

# WhatsApp number that receives order messages (digits with country code)
NEXT_PUBLIC_CLIENT_WHATSAPP=

# Google Apps Script web app that emails, logs to a Google Sheet and stores resumes in Drive (see apps-script/README.md)
SCRIPT_URL=
SCRIPT_SECRET=

# Optional fallback: notification emails through Resend (enquiries, orders, career applications). Without them nothing is emailed;
# everything is still saved and shown in /admin.
RESEND_API_KEY=
MAIL_TO=
MAIL_FROM=
