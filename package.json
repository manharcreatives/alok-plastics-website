{
  "name": "alok-plastics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_SHOW_LAB=1 next dev --turbopack",
    "prebuild": "node scripts/runtime-data.mjs save",
    "build": "next build",
    "postbuild": "node scripts/runtime-data.mjs restore && node scripts/prune-lab.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && node scripts/generate-catalogue.mjs",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && node scripts/check-hex.mjs && node scripts/check-spacing.mjs && node scripts/check-glass.mjs && node scripts/check-forbidden.mjs",
    "lint:hex": "node scripts/check-hex.mjs",
    "lint:spacing": "node scripts/check-spacing.mjs",
    "lint:glass": "node scripts/check-glass.mjs",
    "lint:forbidden": "node scripts/check-forbidden.mjs",
    "test": "playwright test",
    "admin": "php -S 127.0.0.1:8080 -t out",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:screens": "playwright test tests/screens.spec.ts",
    "analyze": "cross-env ANALYZE=true next build",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.1"
}
