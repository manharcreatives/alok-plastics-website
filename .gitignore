# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Alok Plastics project-specific
# design references captured by Playwright (large, local only)
/.research/
# screenshot outputs from QA runs (generated, not source)
/.screenshots/
# PHP SMTP config — never commit credentials
/public/api/config.php
/legacy-php/api/config.php
/legacy-php/admin/config.php
/legacy-php/admin/data/
# client-supplied source documents (PDFs, catalogues)
/content/source/
# client-supplied logo files (vector masters, high-res)
/brand/

# client-supplied brand kit, source docs + QA screenshots (confidential) — local only
/client-kit/

# Scratchpad
# leftover empty scaffold directory (contains its own embedded .git)
/alok-plastics/
# local archive snapshots (.tgz)
/_backup/
# local incoming archive drops (.tgz)
/_incoming/
scripts/.cache/

# the HTTPS CA bundle we vendor for Windows PHP is a known PUBLIC file —
# allow it through the *.pem rule above so fresh clones keep working
!public/api/lib/cacert.pem

# client-supplied design reference (contains GSTIN + bank details) — local only
/GST Invoice.html
# large raw media (edit + commit an encoded/webm copy under public/media instead)
/hero video.mp4

# runtime data written by /admin/ — mutable, and holds real contact +
# GSTIN once the client uses the panel. Commit the *.example.json
# templates instead; runtime-data.ts falls back to src/content/site.ts
# when the file is absent.
/public/data/settings.json
/legacy-php/data/settings.json
/public/data/careers.json
/legacy-php/data/careers.json
/legacy-php/data/product-overrides.json
/legacy-php/data/products.json
/public/data/product-overrides.json

# stray npm lockfile — this repo is pnpm-only (packageManager in package.json)
/package-lock.json
/public/data/products.json

# local dev-server scratch logs
/.deverr.txt
/.devlog.txt
.runtime-backup/

# Google Apps Script (apps-script/alok-forms.gs): email, Google Sheet and resume to Google Drive
/apps-script/*.local.gs
